# =============================================================================
# Rocky — .gitignore
# =============================================================================
# Anything that contains secrets, runtime state, or local-machine output.
# RULE: before every commit, run `git status` and verify nothing in this list
# appears as "to be committed". If it does, .gitignore is broken — fix first.
# =============================================================================

# Secrets — NEVER push these
config.json
Azure ID Info.txt
*.key
*.pem
.env

# Authentication state — local to each machine
state/

# Logs
*.log

# Append-only data files (classifications, reviews, activity)
*.jsonl

# PMA manifest — firm-confidential deal names + contacts; delivered via OneDrive
pma_manifest.json

# Email Brain corpus — James's entire sent-mail corpus + retrieval index.
# NEVER commit: confidential client correspondence. Lives locally on the Rocky laptop.
email_brain/
*.db
*.sqlite
*.sqlite3

# Generated digest output (local/operational, not source)
digests/
maple_digests/

# Python build artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
build/
dist/
*.spec
.venv/
venv/

# OS / editor junk
desktop.ini
Thumbs.db
.DS_Store
.vscode/
.idea/
*.swp

# Claude Code per-machine state — track only launch.json (dev-server config)
.claude/*
!.claude/launch.json

# Screenshots and one-off scratch files (keep the repo clean)
*.png
!Icon/*.png
!Icon/*.ico
inspect_*.py
smoke_test_*.py
scratch_*.py
